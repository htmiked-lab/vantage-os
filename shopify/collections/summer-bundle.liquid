{%- comment -%}
  Tiipikids — Summer Bundles Collection Template

  Usage:
    1. In Shopify admin, create a collection with handle `summer-bundle`.
       Assign bundle products if/when you create dedicated bundle SKUs,
       or rely on the cross-link cards below to drive to individual
       products with the BEACHBUNDLE code at checkout.
    2. Copy this file to templates/collection.summer-bundle.liquid
       (Shopify 1.0) or use as reference for a JSON template section
       (Shopify 2.0).
    3. In the collection admin, set the template to "collection.summer-bundle".

  SEO keywords targeted: kids summer bundle, beach pool bundle,
  toddler outdoor set.
{%- endcomment -%}

<style>
  .tk-collection {
    --tk-green-deep: #3F5D4A;
    --tk-green-soft: #EDF2EE;
    --tk-sand: #F5EFE4;
    --tk-cream: #FAFAF7;
    --tk-ink: #1F2421;
    --tk-neutral: #4A4A47;
    --tk-muted: #6F7670;
    --tk-border: #E3E8E4;
    --tk-accent: #D96C4A;
    font-family: inherit;
    color: var(--tk-ink);
    background: var(--tk-cream);
  }
  .tk-collection *, .tk-collection *::before, .tk-collection *::after { box-sizing: border-box; }
  .tk-collection__wrap { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

  .tk-collection__hero {
    background: linear-gradient(180deg, var(--tk-sand) 0%, var(--tk-cream) 100%);
    padding: 56px 0 48px;
    text-align: center;
  }
  .tk-collection__eyebrow {
    display: inline-block;
    font-size: 12px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--tk-green-deep);
    background: #fff;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .tk-collection__title {
    font-size: 34px; line-height: 1.1;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
    font-weight: 800;
  }
  .tk-collection__lede {
    font-size: 17px;
    color: var(--tk-neutral);
    margin: 0 auto 18px;
    max-width: 640px;
  }
  .tk-collection__promo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 2px dashed var(--tk-green-deep);
    padding: 10px 16px;
    border-radius: 12px;
  }
  .tk-collection__promo-code {
    font-family: ui-monospace, "SF Mono", "Consolas", monospace;
    font-weight: 800;
    font-size: 15px;
    color: var(--tk-green-deep);
    letter-spacing: 0.06em;
  }
  .tk-collection__promo-text {
    font-size: 14px;
    color: var(--tk-neutral);
  }
  @media (min-width: 860px) {
    .tk-collection__hero { padding: 80px 0 64px; }
    .tk-collection__title { font-size: 44px; }
    .tk-collection__lede { font-size: 19px; }
  }

  .tk-collection__seo {
    padding: 40px 0;
    background: #fff;
    border-top: 1px solid var(--tk-border);
    border-bottom: 1px solid var(--tk-border);
  }
  .tk-collection__seo-inner { max-width: 760px; margin: 0 auto; }
  .tk-collection__seo p {
    font-size: 16px;
    color: var(--tk-neutral);
    line-height: 1.7;
    margin: 0 0 16px;
  }
  .tk-collection__seo p:last-child { margin-bottom: 0; }

  .tk-collection__grid-wrap { padding: 56px 0; }
  .tk-collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 28px;
  }
  .tk-product-card {
    background: #fff;
    border: 1px solid var(--tk-border);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .tk-product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(31,36,33,0.08);
    text-decoration: none;
  }
  .tk-product-card__img {
    aspect-ratio: 1/1;
    background: var(--tk-green-soft);
    display: flex; align-items: center; justify-content: center;
    color: var(--tk-muted);
    font-size: 13px;
  }
  .tk-product-card__img img {
    width: 100%; height: 100%; object-fit: cover;
    display: block;
  }
  .tk-product-card__body { padding: 16px 18px 20px; }
  .tk-product-card__title {
    font-size: 15.5px; font-weight: 700;
    margin: 0 0 6px;
    color: var(--tk-ink);
    line-height: 1.3;
  }
  .tk-product-card__price {
    font-size: 15px;
    color: var(--tk-neutral);
    font-weight: 600;
  }

  /* Cross-link cards (shown when bundle products aren't separate SKUs) */
  .tk-crosslinks-wrap { padding: 40px 0 64px; background: var(--tk-cream); }
  .tk-crosslinks__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 32px;
  }
  .tk-crosslinks__head h2 {
    font-size: 24px;
    margin: 0 0 8px;
    font-weight: 800;
  }
  .tk-crosslinks__head p {
    color: var(--tk-neutral);
    margin: 0;
    font-size: 16px;
  }
  .tk-crosslinks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }
  .tk-crosslink {
    display: block;
    background: #fff;
    border: 1px solid var(--tk-border);
    border-radius: 14px;
    padding: 20px 18px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .tk-crosslink:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(31,36,33,0.08);
    text-decoration: none;
  }
  .tk-crosslink__title {
    font-weight: 700;
    font-size: 15px;
    color: var(--tk-ink);
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .tk-crosslink__desc {
    font-size: 13.5px;
    color: var(--tk-muted);
    margin: 0;
  }

  .tk-collection__empty {
    text-align: center;
    padding: 40px 20px;
    color: var(--tk-muted);
  }
</style>

<div class="tk-collection">

  <!-- HERO -->
  <header class="tk-collection__hero">
    <div class="tk-collection__wrap">
      <span class="tk-collection__eyebrow">Summer Bundles</span>
      <h1 class="tk-collection__title">Kids Summer Bundles — Beach Pool, Toys, and More</h1>
      <p class="tk-collection__lede">
        Curated bundles that turn one order into a full summer kit for your toddler. The beach pool bundle, the bath-and-beach crossover set, and complete toddler outdoor sets — all at a bundle price with no extra math.
      </p>
      <div class="tk-collection__promo">
        <span class="tk-collection__promo-code">BEACHBUNDLE</span>
        <span class="tk-collection__promo-text">$10 off when you add 2+ items</span>
      </div>
    </div>
  </header>

  <!-- SEO DESCRIPTION -->
  <section class="tk-collection__seo">
    <div class="tk-collection__wrap tk-collection__seo-inner">
      {%- if collection.description != blank -%}
        {{ collection.description }}
      {%- else -%}
        <p>Building a summer lineup for a toddler one product at a time is exhausting. Our <strong>kids summer bundle</strong> pages curate gear that works together — so one order gets you a matched beach pool, silicone toy set, and the accessories that actually fit into your beach tote. No guesswork, no overlap, no extra shipping.</p>
        <p>Looking for a <strong>beach pool bundle</strong> for a toddler's first real summer? Or a complete <strong>toddler outdoor set</strong> that handles bath, beach, and backyard with the same silicone gear? This is where you start. Every piece is BPA-free, non-toxic, UV-stable, and built to survive multiple kids — so the bundle you buy this summer is still going in two summers.</p>
      {%- endif -%}
    </div>
  </section>

  <!-- BUNDLE PRODUCT GRID (if any) -->
  {%- if collection.products_count > 0 -%}
  <section class="tk-collection__grid-wrap">
    <div class="tk-collection__wrap">
      <div class="tk-collection__grid">
        {%- for product in collection.products -%}
          <a class="tk-product-card" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
            <div class="tk-product-card__img">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 800 }}"
                     alt="{{ product.featured_image.alt | default: product.title | escape }}"
                     loading="lazy" width="800" height="800">
              {%- else -%}
                <span>[Product image]</span>
              {%- endif -%}
            </div>
            <div class="tk-product-card__body">
              <h2 class="tk-product-card__title">{{ product.title }}</h2>
              <div class="tk-product-card__price">{{ product.price | money }}</div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- CROSS-LINKS: individual products that can be bundled with BEACHBUNDLE code -->
  <section class="tk-crosslinks-wrap">
    <div class="tk-collection__wrap">
      <div class="tk-crosslinks__head">
        <h2>Build your own bundle</h2>
        <p>Add any two products below to your cart and use <strong>BEACHBUNDLE</strong> at checkout for $10 off.</p>
      </div>

      <div class="tk-crosslinks">
        <a class="tk-crosslink" href="/products/beach-pool-with-3pc-water-bags">
          <div class="tk-crosslink__title">Tiipikids Beach Pool</div>
          <p class="tk-crosslink__desc">The anchored beach pool that actually stays put on sand. $49.99.</p>
        </a>
        <a class="tk-crosslink" href="/products/beach-pool-with-shade">
          <div class="tk-crosslink__title">Beach Pool with Shade</div>
          <p class="tk-crosslink__desc">All-in-one sun-and-water setup with UPF 50+ canopy. $69.99.</p>
        </a>
        <a class="tk-crosslink" href="/products/beach-bucket-set-4pc-with-shovel">
          <div class="tk-crosslink__title">Beach Bucket Set 4pc</div>
          <p class="tk-crosslink__desc">Silicone bucket, flexible shovel, 2 scoops/molds. $19.99.</p>
        </a>
        <a class="tk-crosslink" href="/products/bath-buddy-set-bath-toy-organizer-with-4-pc-silicone-set">
          <div class="tk-crosslink__title">Bath Buddy Set</div>
          <p class="tk-crosslink__desc">Wall-mounted silicone organizer + 4pc toy set. $49.99.</p>
        </a>
        <a class="tk-crosslink" href="/products/silicone-bath-toys">
          <div class="tk-crosslink__title">Cuties 4pc Silicone Bath Toys</div>
          <p class="tk-crosslink__desc">Mold-free silicone bath toys with no hollow cavities.</p>
        </a>
      </div>
    </div>
  </section>

</div>

{%- comment -%} JSON-LD CollectionPage schema {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Summer Bundles",
  "description": "Kids summer bundles, beach pool bundles, and toddler outdoor sets from Tiipikids. Curated gear that works together for bath, beach, and backyard — all with our BEACHBUNDLE $10-off promo.",
  "url": "{{ shop.url }}{{ collection.url }}",
  "inLanguage": "en",
  "isPartOf": {
    "@type": "WebSite",
    "name": "{{ shop.name | escape }}",
    "url": "{{ shop.url }}"
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count | default: 5 }},
    "itemListElement": [
      {%- if collection.products_count > 0 -%}
        {%- for product in collection.products limit: 20 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": "{{ shop.url }}{{ product.url }}",
          "name": {{ product.title | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {
          "@type": "ListItem",
          "position": 1,
          "url": "{{ shop.url }}/products/beach-pool-with-3pc-water-bags",
          "name": "Tiipikids Beach Pool"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "url": "{{ shop.url }}/products/beach-pool-with-shade",
          "name": "Beach Pool with Shade"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "url": "{{ shop.url }}/products/beach-bucket-set-4pc-with-shovel",
          "name": "Beach Bucket Set 4pc with Shovel"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "url": "{{ shop.url }}/products/bath-buddy-set-bath-toy-organizer-with-4-pc-silicone-set",
          "name": "Bath Buddy Set"
        },
        {
          "@type": "ListItem",
          "position": 5,
          "url": "{{ shop.url }}/products/silicone-bath-toys",
          "name": "Cuties 4pc Silicone Bath Toys"
        }
      {%- endif -%}
    ]
  }
}
</script>
