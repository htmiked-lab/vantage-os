{%- comment -%}
  Tiipikids Product Schema Markup
  Injectable JSON-LD for Shopify theme.liquid

  Usage:
    1. Copy this entire file into snippets/ as `product-schema.liquid`
    2. In theme.liquid, add before </head>:
         {% render 'product-schema' %}
    3. Or paste the contents directly into theme.liquid before </head>.

  Notes:
    - Schemas render only on product pages for the 5 active SKUs below.
    - AggregateRating uses placeholder values (4.8 stars / 500 reviews).
      Update `placeholder_rating_value` and `placeholder_review_count`
      after Judge.me import, or swap to dynamic variables from your
      review app: e.g. product.metafields.judgeme.rating.
    - Prices and availability pull from Shopify so they stay live.
{%- endcomment -%}

{%- if template.name == 'product' -%}

  {%- assign placeholder_rating_value = '4.8' -%}
  {%- assign placeholder_review_count = '500' -%}
  {%- assign brand_name = 'Tiipikids' -%}
  {%- assign currency = cart.currency.iso_code | default: 'USD' -%}
  {%- if product.available -%}
    {%- assign availability = 'https://schema.org/InStock' -%}
  {%- else -%}
    {%- assign availability = 'https://schema.org/OutOfStock' -%}
  {%- endif -%}

  {%- case product.handle -%}

    {%- when 'bath-buddy-set-bath-toy-organizer-with-4-pc-silicone-set' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": "Bath Buddy Set — Bath Toy Organizer with 4pc Silicone Set",
        "description": "A wall-mounted silicone bath toy organizer paired with a 4-piece silicone toy set. Strong suction mount, fast drainage, mold-resistant, dishwasher-safe. The complete bath reset in one purchase.",
        "sku": "BT-04",
        "brand": {
          "@type": "Brand",
          "name": "{{ brand_name }}"
        },
        "image": [
          {%- for image in product.images limit: 5 -%}
            "https:{{ image | image_url: width: 1200 }}"{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "url": "{{ shop.url }}{{ product.url }}",
        "offers": {
          "@type": "Offer",
          "url": "{{ shop.url }}{{ product.url }}",
          "priceCurrency": "{{ currency }}",
          "price": "49.99",
          "availability": "{{ availability }}",
          "itemCondition": "https://schema.org/NewCondition"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ placeholder_rating_value }}",
          "reviewCount": "{{ placeholder_review_count }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
      </script>

    {%- when 'beach-pool-with-3pc-water-bags' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": "Tiipikids Beach Pool with 3pc Water Bags",
        "description": "A lightweight, fold-flat portable beach pool engineered for sand. Includes three water-bag anchors that keep the pool stable on uneven terrain. Fast setup, fast drain, built to last multiple summers.",
        "sku": "{{ product.selected_or_first_available_variant.sku | default: 'TK-BP-01' }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ brand_name }}"
        },
        "image": [
          {%- for image in product.images limit: 5 -%}
            "https:{{ image | image_url: width: 1200 }}"{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "url": "{{ shop.url }}{{ product.url }}",
        "offers": {
          "@type": "Offer",
          "url": "{{ shop.url }}{{ product.url }}",
          "priceCurrency": "{{ currency }}",
          "price": "49.99",
          "availability": "{{ availability }}",
          "itemCondition": "https://schema.org/NewCondition"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ placeholder_rating_value }}",
          "reviewCount": "{{ placeholder_review_count }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
      </script>

    {%- when 'beach-pool-with-shade' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": "Tiipikids Beach Pool with Shade",
        "description": "A portable beach pool with an integrated UPF 50+ canopy. Keeps water cooler and toddlers protected during peak sun. Water-bag anchors stabilize the pool on uneven sand. The all-in-one sun-and-water setup for beach days.",
        "sku": "{{ product.selected_or_first_available_variant.sku | default: 'TK-BPS-01' }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ brand_name }}"
        },
        "image": [
          {%- for image in product.images limit: 5 -%}
            "https:{{ image | image_url: width: 1200 }}"{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "url": "{{ shop.url }}{{ product.url }}",
        "offers": {
          "@type": "Offer",
          "url": "{{ shop.url }}{{ product.url }}",
          "priceCurrency": "{{ currency }}",
          "price": "69.99",
          "availability": "{{ availability }}",
          "itemCondition": "https://schema.org/NewCondition"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ placeholder_rating_value }}",
          "reviewCount": "{{ placeholder_review_count }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
      </script>

    {%- when 'silicone-bath-toys' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": "Cuties 4pc Silicone Bath Toys",
        "description": "A 4-piece set of solid food-grade silicone bath toys. No hollow cavities, no squeaker holes, no mold. Soft, grippy, dishwasher-safe, and safe for little mouths. The clean-bath-time starter set.",
        "sku": "{{ product.selected_or_first_available_variant.sku | default: 'TK-CBT-04' }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ brand_name }}"
        },
        "image": [
          {%- for image in product.images limit: 5 -%}
            "https:{{ image | image_url: width: 1200 }}"{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "url": "{{ shop.url }}{{ product.url }}",
        "offers": {
          "@type": "Offer",
          "url": "{{ shop.url }}{{ product.url }}",
          "priceCurrency": "{{ currency }}",
          "price": "{{ product.price | money_without_currency | strip_html }}",
          "availability": "{{ availability }}",
          "itemCondition": "https://schema.org/NewCondition"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ placeholder_rating_value }}",
          "reviewCount": "{{ placeholder_review_count }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
      </script>

    {%- when 'beach-bucket-set-4pc-with-shovel' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": "Beach Bucket Set 4pc with Shovel",
        "description": "A 4-piece silicone beach set — bucket, flexible shovel, and two scoops/molds. UV-stable, flexes instead of cracking, rinses clean in seconds. Built to survive real toddler beach play summer after summer.",
        "sku": "{{ product.selected_or_first_available_variant.sku | default: 'TK-BB-04' }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ brand_name }}"
