{%- comment -%}
  Tiipikids — Custom robots.txt for Shopify

  Where to install:
    Shopify admin → Online Store → Themes → Actions → Edit code →
    templates/robots.txt.liquid → paste this file.

  What this does:
    1. Starts from Shopify's default groups (which already block /admin,
       /cart, /checkout, /orders, /account/*, /search, etc.) so we don't
       accidentally open anything up.
    2. Appends extra disallow rules for search-result URLs, filter query
       strings, and other crawl-waste paths.
    3. Explicitly allows product, collection, blog, and page paths so we
       stay on the record about what should be indexed.
    4. References the canonical sitemap that Shopify generates for us.

  Verifying after deploy:
    curl -i https://tiipikids.com/robots.txt
    Or check: https://www.google.com/webmasters/tools/robots-testing-tool
{%- endcomment -%}
# robots.txt for {{ shop.name }} — {{ shop.url }}
# Auto-generated by Shopify, extended for Tiipikids SEO.

{% for group in robots.default_groups -%}
  {{- group.user_agent }}

  {%- comment -%} Explicit allow lines for crawlable sections {%- endcomment -%}
  {%- if group.user_agent.value == '*' -%}
    {{ "\n" }}Allow: /products
    {{ "\n" }}Allow: /products/
    {{ "\n" }}Allow: /collections
    {{ "\n" }}Allow: /collections/
    {{ "\n" }}Allow: /blogs
    {{ "\n" }}Allow: /blogs/
    {{ "\n" }}Allow: /pages/
  {%- endif -%}

  {%- comment -%} Shopify's defaults (keeps admin, cart, checkout, account blocks) {%- endcomment -%}
  {%- for rule in group.rules -%}
    {{ "\n" }}{{ rule }}
  {%- endfor -%}

  {%- comment -%} Extra disallows beyond Shopify defaults {%- endcomment -%}
  {%- if group.user_agent.value == '*' -%}
    {{ "\n" }}
    {{ "\n" }}# Custom Tiipikids rules — block crawl-waste and duplicate pages
    {{ "\n" }}Disallow: /search
    {{ "\n" }}Disallow: /search?
    {{ "\n" }}Disallow: /*?q=*
    {{ "\n" }}Disallow: /*?filter.*
    {{ "\n" }}Disallow: /*?sort_by=*
    {{ "\n" }}Disallow: /*?variant=*
    {{ "\n" }}Disallow: /*?grid_list=*
    {{ "\n" }}Disallow: /*?page=*
    {{ "\n" }}Disallow: /*?view=*
    {{ "\n" }}Disallow: /*.atom$
    {{ "\n" }}Disallow: /cart
    {{ "\n" }}Disallow: /cart/
    {{ "\n" }}Disallow: /checkout
    {{ "\n" }}Disallow: /checkouts/
    {{ "\n" }}Disallow: /account
    {{ "\n" }}Disallow: /account/
    {{ "\n" }}Disallow: /admin
    {{ "\n" }}Disallow: /admin/
    {{ "\n" }}Disallow: /apple-app-site-association
    {{ "\n" }}Disallow: /.well-known/
    {{ "\n" }}Disallow: /password
    {{ "\n" }}Disallow: /policies/
  {%- endif -%}

  {%- if group.sitemap != blank -%}
    {{ "\n" }}{{ group.sitemap }}
  {%- endif -%}
{% endfor %}

{%- comment -%} Canonical sitemap (Shopify auto-generates this) {%- endcomment -%}

Sitemap: {{ shop.url }}/sitemap.xml

{%- comment -%} Optional: slow down aggressive / low-value crawlers {%- endcomment -%}

User-agent: AhrefsBot
Crawl-delay: 10

User-agent: SemrushBot
Crawl-delay: 10

User-agent: MJ12bot
Crawl-delay: 10
